{
  "name": "taskflow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/tasks.test.ts",
    "check": "npm run typecheck && npm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/jwt": "latest",
    "@fastify/swagger": "latest",
    "@fastify/swagger-ui": "latest",
    "@fastify/type-provider-typebox": "latest",
    "@prisma/client": "^6.12.0",
    "@sinclair/typebox": "latest",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prisma": "^6.12.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
