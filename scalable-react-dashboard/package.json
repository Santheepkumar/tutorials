{
  "name": "scalable-react-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "media:capture": "playwright test -c playwright.media.config.ts",
    "size": "size-limit",
    "check": "npm-run-all --sequential format:check lint typecheck test:coverage build size",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@playwright/test": "^1.55.0",
    "@size-limit/file": "^12.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.0",
    "msw": "^2.12.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.0",
    "size-limit": "^12.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --check"
  },
  "size-limit": [
    {
      "name": "production JavaScript",
      "path": "dist/assets/*.js",
      "limit": "250 kB"
    }
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
